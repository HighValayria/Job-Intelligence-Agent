# Copy this file to .env and fill in your real API key.
# The local .env file is ignored by git.

JOB_INTEL_LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
JOB_INTEL_LLM_API_KEY=
JOB_INTEL_LLM_MODEL=kimi-k3

# Moonshot-style aliases are also supported:
# MOONSHOT_API_KEY=
# MOONSHOT_MODEL=kimi-k3

# Algorithm Daily Push
# Keep disabled until the registry is reviewed and the target is confirmed.
PUSH_ENABLED=false
PUSH_TIME=09:00
TIMEZONE=Asia/Shanghai
PUSH_ADAPTER=console

# Set PUSH_ADAPTER=qq to send through QQ Bot.
QQ_BOT_TARGET_TYPE=group
# Use the target openid from QQ Bot events/API, not a visible QQ group number.
QQ_BOT_TARGET_ID=
QQ_BOT_APP_ID=
QQ_BOT_CLIENT_SECRET=
# Optional if you manage tokens elsewhere:
# QQ_BOT_ACCESS_TOKEN=
# Comma-separated sender openids allowed to add questions through webhook commands.
QQ_BOT_ADMIN_OPENIDS=
